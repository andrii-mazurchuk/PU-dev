        {
          "kind": "text",
          "title": "Prompt",
          "note": "what this session was actually given",
          "span": 6,
          "source": "sessions/{uuid}/{run_id}",
          "field": "prompt"
        }
      ]
    },
    {
      "id": "spend",
      "title": "Spend",
      "panels": [
        {
          "kind": "kpis",
          "span": 12,
          "items": [
            {
              "label": "Spent today",
              "source": "stats:metrics.gate.cost.spent_today_usd"
            },
            {
              "label": "Daily cap",
              "source": "stats:metrics.gate.cost.daily_cap_usd",
              "sub": "unit-side; the gateway carries the policy and never reads it"
            },
            {
              "label": "Total",
              "source": "stats:metrics.sessions.cost_usd_total"
            }
          ]
        },
        {
          "kind": "bars",
          "title": "Cost per day",
          "note": "quiet days are present as zero, not omitted",
          "span": 12,
          "source": "spend",
          "path": "days",
          "x": "day",
          "y": "cost_usd"
        }
      ]
    }
  ]
}
